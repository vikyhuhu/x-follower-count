{
  "manifest_version": 3,
  "name": "X 粉丝数",
  "version": "1.0.1",
  "description": "将 X 页面已有响应里的粉丝数量显示在用户名字旁。数据只保存在当前页面。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["data.js", "network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
