{
  "manifest_version": 3,
  "name": "X 粉丝数",
  "version": "1.0.4",
  "description": "在 X 用户名称区域显示粉丝数、关注关系和注册未满 90 天的新号标签。数据只保存在当前页面。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "X 粉丝数",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["data.js", "network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
